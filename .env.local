# Copy .env.local.example to .env.local and fill in the paths for your machine.
# This file is git-ignored — never commit real paths here.

# --- Speech-to-text (faster-whisper) ---
# Model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Local LLM (llama.cpp via llama-cpp-python) ---
# Point this at a GGUF file, e.g. a quantized Qwen2.5-3B-Instruct.
# Search "<model name> GGUF" on Hugging Face to find one.
LLAMA_MODEL_PATH=/path/to/your/model.gguf
LLAMA_CTX=4096
# Defaults to half your CPU cores if unset — adjust as needed.
# LLAMA_N_THREADS=4

# --- Text-to-speech (Piper) ---
# PIPER_BIN can stay "piper" if the CLI is on your PATH after pip install piper-tts.
# PIPER_MODEL_PATH needs a downloaded Piper voice (.onnx).
# Get voices from: https://github.com/rhasspy/piper/blob/master/VOICES.md
PIPER_BIN=piper
PIPER_MODEL_PATH=/path/to/your/voice.onnx
