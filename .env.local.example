# Copy this file to .env.local and fill in real paths on your machine.
# Resonant runs fully locally now — no API keys needed, just model files.

# --- Speech-to-text (faster-whisper) ---
# Model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Local LLM (llama.cpp via llama-cpp-python) ---
# Point this at a GGUF file, e.g. a quantized Qwen2.5-3B-Instruct or
# Llama-3.2-3B-Instruct. Search "<model name> GGUF" on Hugging Face.
LLAMA_MODEL_PATH=/absolute/path/to/model.gguf
LLAMA_CTX=4096
LLAMA_N_THREADS=4

# --- Text-to-speech (Piper) ---
# PIPER_BIN can stay "piper" if the CLI is on your PATH after
# `pip install piper-tts`. PIPER_MODEL_PATH needs a downloaded Piper
# voice (.onnx) — e.g. en_US-lessac-medium.onnx from the Piper voices repo.
PIPER_BIN=piper
PIPER_MODEL_PATH=/absolute/path/to/voice.onnx
