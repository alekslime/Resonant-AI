# LiveKit Cloud dashboard -> your project -> Settings -> Keys

# Long random string. The phone sends it to token_server.py (Settings > Debug Mode > Server setup).
# Make one: python -c "import secrets; print(secrets.token_hex(24))"
# Only for token_server.py: the phone must send this. Make it long and random.
TOKEN_KEY=make-a-long-random-string

# Copy this file to .env (same folder) and fill it in. Never commit .env.
# LiveKit Cloud dashboard -> your project -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret


# Optional, these are the defaults
# WHISPER_MODEL=base.en
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434/v1
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=1.0
# STOP_WORDS=1
# TOKEN_PORT=8787
# TOKEN_HOST=0.0.0.0

# Optional: answer with the Meta Model API instead of Ollama (Ollama stays as the fallback and the command router).
# Same key as cloud.apiKey in local.properties. Leave CLOUD_API_KEY out to keep using Ollama only.
# CLOUD_API_KEY=
# CLOUD_BASE_URL=https://api.meta.ai/v1
# CLOUD_MODEL=muse-spark-1.3
# CLOUD_MAX_TOKENS=1500
