<resources>
    <style name="Theme.Resonant" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Cold-start colors match the brand orange so there is no black or white flash before
             the first screen draws. Screens repaint the bars themselves (SystemBarsColor.kt). -->
        <item name="android:statusBarColor">#FFAE00</item>
        <item name="android:navigationBarColor">#FFAE00</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#FFAE00</item>
    </style>
</resources>
