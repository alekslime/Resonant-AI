+                requestMethod = "POST"
+                doOutput = true
+                connectTimeout = CHECK_TIMEOUT_MS
+                readTimeout = WARM_UP_READ_TIMEOUT_MS
+                setRequestProperty("Content-Type", "application/json")
+            }
+            try {
